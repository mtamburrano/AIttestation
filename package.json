    "build:consumer": "node spikes/demonstrator/build-macos.mjs",
    "build:chatgpt": "node spikes/browser/chatgpt/build-macos.mjs",
    "build:distribution": "node spikes/distribution/build-macos.mjs",
    "test:distribution": "node --test test/distribution.test.mjs",
    "test:distribution-browser": "node test/distribution-browser.mjs",
    "build:verifier": "node spikes/recipient/build-macos.mjs",
    "verify:evidence": "node spikes/recipient/verify.mjs",
    "test:recipient-browser": "node test/recipient-browser.mjs",
    "test:consumer-browser": "node test/demonstrator-browser.mjs",
