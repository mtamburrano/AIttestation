{
  "manifest_version": 3,
  "name": "Private Provenance — ChatGPT release adapter",
  "version": "1.1.0",
  "key": "",
  "minimum_chrome_version": "153",
  "description": "Releases already-authorized text from the local trusted composer to one supported ChatGPT tab.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
