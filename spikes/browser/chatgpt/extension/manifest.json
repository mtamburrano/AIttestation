{
  "manifest_version": 3,
  "name": "Attestamp for ChatGPT",
  "short_name": "Attestamp",
  "version": "1.6.0",
  "key": "",
  "minimum_chrome_version": "153",
  "description": "Use the Attestamp desktop app to save normal prompts with consent or protect text sent to a selected supported ChatGPT tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": { "default_title": "Open Attestamp" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": { "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
